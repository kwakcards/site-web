# =============================================================================
# Kwak & Cards : variables d'environnement
# =============================================================================
# En local : copier ce fichier en .env.local puis le compléter.
#   cp .env.example .env.local
# Sur Vercel : Settings → Environment Variables, en séparant Production
# (Supabase prod) et Preview/Development (Supabase dev).
#
# Règles :
# - Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : jamais de
#   secret dedans.
# - .env.local n'est jamais commité (voir .gitignore).
# =============================================================================

# --- Site ---------------------------------------------------------------------
# URL publique du site, sans slash final. Le domaine est encore à définir.
# Sur les previews Vercel, laisser vide : l'URL de la preview est utilisée.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de données, authentification, stockage des images) -------
# Supabase → Project Settings → API Keys.
# Projet « kwakcards-dev » en local et en preview, projet de prod en production.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clé publique « publishable » (sb_publishable_...) : lecture publique limitée par la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_...) : SERVEUR UNIQUEMENT, contourne la RLS.
# Sert à créer les commandes et à lire les réglages de paiement.
SUPABASE_SECRET_KEY=

# --- Emails transactionnels (Resend, compte de l'entreprise) ---------------------
# Resend → API Keys. Sans clé, les emails sont simplement écrits dans la console.
RESEND_API_KEY=
# Expéditeur : doit appartenir au domaine vérifié chez Resend (kwak-and-cards.fr).
EMAIL_FROM="Kwak & Cards <contact@kwak-and-cards.fr>"
# Adresse qui reçoit les alertes (demande de rachat, commande, rétractation) et les
# réponses des clients.
SHOP_NOTIFICATION_EMAIL=

# --- Sécurité -------------------------------------------------------------------
# Secret servant à hacher les adresses IP (limite de commandes en attente par
# client) sans les stocker en clair. Générer une valeur aléatoire, par ex. :
#   openssl rand -base64 32
IP_HASH_SECRET=

# --- Démonstration (projet Supabase de DEV uniquement) ---------------------------
# Compte admin de test utilisé par scripts/demo/demo-catalog.mts (photos des
# articles fictifs) et pour essayer l'admin en local. Ne jamais le créer en prod.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
